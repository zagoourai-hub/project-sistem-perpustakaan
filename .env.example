# ─────────────────────────────────────────────────────────────────────────────
# Pustaka — semua environment variable.
#  • Development : backend/.env (salin backend/.env.example) + frontend/.env.local
#  • Production  : salin file ini ke docker/.env, dipakai docker/docker-compose.prod.yml
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & URL ──────────────────────────────────────────────────────────────
# Origin publik aplikasi (frontend). API & file diakses same-origin lewat rewrite Next.
PUBLIC_URL=https://perpustakaan.sekolah.sch.id

# ── Database (Postgres 17 + pgvector + pg_trgm) ───────────────────────────────
POSTGRES_USER=pustaka
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=pustaka
# Dibentuk otomatis di compose prod dari tiga nilai di atas; isi manual bila DB eksternal
# DATABASE_URL=postgresql://pustaka:***@postgres:5432/pustaka

# ── Backend (NestJS) ──────────────────────────────────────────────────────────
# Wajib: string acak ≥ 32 karakter, mis. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# true di balik HTTPS (production)
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Jakarta

# Storage: local = volume Docker (disajikan /uploads), s3 = MinIO/S3/R2 eksternal
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=pustaka
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.example.com/pustaka   # prefix covers/ harus public-read

# Email (SMTP). Dev: Mailpit localhost:1025 tanpa auth
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Perpustakaan <no-reply@sekolah.sch.id>

# AI (opsional). Kosong = pencarian full-text saja, tanpa rekomendasi personal
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# Admin awal untuk seed (wajib ganti password saat login pertama)
SEED_ADMIN_EMAIL=admin@sekolah.sch.id
SEED_ADMIN_PASSWORD=GantiSegera123

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Alamat backend dari sisi server Next (rewrite /api/v1 & /uploads, Server Components).
# Di compose: http://backend:3001. Dibaca saat BUILD dan runtime.
BACKEND_URL=http://backend:3001

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# Jam backup harian (0–23, waktu container / UTC)
BACKUP_HOUR=19
