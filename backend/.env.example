# Salin ke .env. Infra lokal: docker compose -f ../docker/docker-compose.yml up -d
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://pustaka:pustaka@localhost:5432/pustaka
REDIS_URL=redis://localhost:6379
# Origin frontend yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:3000
PORTAL_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
APP_TIMEZONE=Asia/Jakarta

# Minimal 32 karakter acak
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# true di production (HTTPS)
COOKIE_SECURE=false

# local = folder uploads/ ; s3 = MinIO/S3 (production)
STORAGE_DRIVER=local
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=pustaka
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# Mailpit lokal: UI di http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Pustaka <no-reply@pustaka.local>

# Kosong = AI mati, pencarian fallback ke full-text
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# Admin awal untuk seed
SEED_ADMIN_EMAIL=admin@pustaka.local
SEED_ADMIN_PASSWORD=Admin12345
